# box_system 环境变量配置示例
# 复制此文件为 .env 并填入实际值
# cp .env.example .env

# ===== 必须设置的变量（无默认值，未设置则服务无法启动） =====

# JWT 密钥 - 必须设置为强随机字符串（至少 32 字符）
# 生成方法: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=your-very-strong-random-secret-key-at-least-32-chars

# 默认管理员密码 - 首次启动时用于创建管理员账号
DEFAULT_ADMIN_PASSWORD=your-strong-admin-password

# ===== 可选变量（有默认值） =====

# vLLM 视觉模型服务地址
# VLLM_QWEN3VL_URL=http://localhost:8003

# CORS 允许的来源（逗号分隔）
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 摄像头页面视觉模型（容器内路径；宿主机挂载见 docker-compose.yml）
# YOLO_DETECT_MODEL_PATH=/models/runs/yolo26x_continue/weights/best.pt
# YOLO_CLASSIFY_MODEL_PATH=/models/disaster-classifier/best.pt
# YOLO_CLASSIFY_FALLBACK_PATH=

# Low-light pre-processing before YOLO inference. Auto mode only enhances dark frames.
# VISION_LOW_LIGHT_ENHANCE=true
# VISION_LOW_LIGHT_MODE=auto
# VISION_LOW_LIGHT_MEAN_THRESHOLD=72
# VISION_LOW_LIGHT_P10_THRESHOLD=45
# VISION_LOW_LIGHT_CLAHE_CLIP=2.2
# VISION_LOW_LIGHT_CLAHE_TILE=8
# VISION_LOW_LIGHT_GAMMA=0.72
# VISION_LOW_LIGHT_SHARPEN=0.18

# WebRTC Streamer（默认由 docker-compose.yml 启动并仅监听回环地址）
# WEBRTC_STREAMER_URL=http://127.0.0.1:8002
# WEBRTC_STREAM_OPTIONS=rtptransport=tcp&timeout=10

# 请求限制
# MAX_IMAGE_SIZE_MB=10

# IoTDB 配置
# IOTDB_HOST=127.0.0.1
# IOTDB_PORT=6667

# MySQL 配置
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=root
# MYSQL_DATABASE=dam_system

# JWT 配置
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_SECONDS=1296000

# 默认管理员用户名和真实姓名
# DEFAULT_ADMIN_USERNAME=admin
# DEFAULT_ADMIN_REALNAME=管理员

# Redis 配置
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=redis

# MinIO / 文档存储
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_SECURE=false
# DOCUMENT_BUCKET=documents

# OnlyOffice / 文档编辑
# APP_PORT=8090
# PUBLIC_HOST=192.168.31.52
# BACKEND_PUBLIC_URL=http://192.168.31.52:8090
# ONLYOFFICE_PUBLIC_URL=http://192.168.31.52
# ONLYOFFICE_JWT_SECRET=your-onlyoffice-secret

# 无人机巡航动作
# simulation：当前页面演示模式，调用 DJI 模拟飞行并从对应演示视频取四张图。
# real：调用 DJI 航线任务和拍照指令；需要填入 workspace/dock/两条航线 file id。
# DRONE_CRUISE_EXECUTOR=simulation
# DJI_CLOUD_API_BASE_URL=http://127.0.0.1:6790
# DJI_CLOUD_API_USERNAME=adminPC
# DJI_CLOUD_API_PASSWORD=adminPC
# DRONE_CRUISE_WORKSPACE_ID=
# DRONE_CRUISE_DOCK_SN=
# DRONE_CRUISE_FISHING_FILE_ID=
# DRONE_CRUISE_WADING_FILE_ID=
# DRONE_CRUISE_PAYLOAD_INDEX=88-0-0
# DRONE_CRUISE_OBJECT_PREFIX=drone-cruises
# DRONE_CRUISE_DEMO_OBJECT_PREFIX=drone-cruises/demo
# DRONE_CRUISE_PICTURE_ROOT=/app/data/drone_pictures
# STAFF_TASK_DEMO_PICTURE_ROOT=/app/data/worker_pictures
# STAFF_TASK_DEMO_OBJECT_PREFIX=safety-events/demo-field-images
# STAFF_TASK_DEMO_DELAY_SECONDS=10
# VITE_API_BASE_URL=http://192.168.31.52:8090
# VITE_ONLYOFFICE_URL=http://192.168.31.52
# Jetson 主机级 socat：12345 -> 192.168.1.64:80，后端不监听摄像头控制台端口
# CAMERA_WEB_PROXY_EXTERNAL=true
# CAMERA_WEB_PROXY_PRIMARY_PORT=12345
# 小程序 live-player 使用的 RTMP 实时流（生产环境按微信后台合法域名配置）
# MINIPROGRAM_LIVE_PUBLIC_BASE_URL=rtmp://192.168.31.52:1936
# MINIPROGRAM_LIVE_PUBLISH_BASE_URL=rtmp://127.0.0.1:1936
# Web 监控页默认使用摄像头主码流（海康 101）；如需优先流畅度可设为 true 使用子码流（102）。
# CAMERA_WEB_LIVE_USE_SUBSTREAM=false
# MINIPROGRAM_LIVE_USE_SUBSTREAM=true

# 每日巡检报告：每天 00:00 汇总前一自然日，写入文档中心
# PATROL_REPORT_AUTO_ENABLED=true
# PATROL_REPORT_AUTO_TIME=00:00
# PATROL_REPORT_USER_ID=user_001
# PATROL_REPORT_USER_NAME=管理员

# 微信小程序订阅消息
# AppSecret 建议放 dam-miniprogram/wechat-keys/wechat.env，该目录已被小程序 .gitignore 忽略。
# WECHAT_MINIPROGRAM_APP_ID=wx0915df56d799f471
# WECHAT_MINIPROGRAM_APP_SECRET=your-wechat-app-secret
# WECHAT_RISK_TEMPLATE_ID=5NGdwcxDcjqwTuuCCp-LTbiSEl4Cp8N08wN-0R-WbcA
# 模板字段顺序：风险级别、风险类型、风险标题、发布时间。
# 如果微信模板关键词不是 thing1/thing2/thing3/time4，在这里改成实际 keyword。
# WECHAT_RISK_TEMPLATE_FIELDS=thing1,thing2,thing3,time4
# 一次性模板使用 once；微信后台开通长期模板后可改 permanent。
# WECHAT_RISK_SUBSCRIPTION_TYPE=once
# WECHAT_NOTIFY_ENABLED=true

# USB 外放 / 喊话
# 真实部署建议关闭 LOCAL_AUDIO 测试设备，避免接口显示成功但现场没声音。
# 当前 Jetson 上 USB 扬声器 ERAZER D01 被识别为 card 2，可用 plughw:2,0。
# 如果更换 USB 口或声卡序号变化，用 cat /proc/asound/cards 重新确认。
# BROADCAST_ENABLE_LOCAL_TEST_DEVICE=false
# BROADCAST_ENABLE_USB_AUDIO_DEVICE=true
# BROADCAST_USB_ALSA_DEVICE=plughw:2,0
# BROADCAST_TTS_VOICE=cmn
# BROADCAST_TTS_SPEED_WPM=150
# BROADCAST_AUDIO_BUSY_RETRIES=5
# BROADCAST_AUDIO_BUSY_RETRY_SECONDS=1

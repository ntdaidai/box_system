# MinIO 配置
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# 模型配置
MODEL_WEIGHTS=/app/models/mobilenetv4_conv_medium_cls_default.pt
MODEL_BACKEND=timm
MODEL_NAME=mobilenetv4_conv_medium.e500_r256_in1k
CLASS_NAMES=
DEVICE=0
IMG_SIZE=256
TOP_K=3

# 服务器配置
HOST=0.0.0.0
PORT=8000
WORKERS=1

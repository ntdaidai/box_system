# DAM 系统配置

# 模型库数据库
MODEL_REGISTRY_DB_HOST=192.168.31.52
MODEL_REGISTRY_DB_PORT=3306
MODEL_REGISTRY_DB_USER=root
MODEL_REGISTRY_DB_PASSWORD=root
MODEL_REGISTRY_DB_NAME=dam_system

# 模型库 API
MODEL_REGISTRY_API_BASE=http://192.168.31.52:5001

# 服务配置
HOST=0.0.0.0
PORT=5002

# LLM 模型 ID（在模型库中的记录 ID）
LLM_LOCAL_MODEL_ID=       # 本地模型 ID（如 10 = qwen4B），用于场景推理和初步报告
LLM_CLOUD_MODEL_ID=       # 云端模型 ID（待注册 = qwen35B），用于综合分析和最终报告
LLM_FALLBACK_MODEL_ID=    # 兜底模型 ID（如 9 = qwen0.8B），用于 IO 匹配等轻量任务

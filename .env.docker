# Docker Compose 环境变量配置
# 复制此文件为 .env 并填入实际值
# cp .env.docker .env

# ===== 必须设置的变量 =====

# JWT 密钥 - 必须设置为强随机字符串
# 生成方法: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-strong-random-secret

# 默认管理员密码
DEFAULT_ADMIN_PASSWORD=change-me-to-a-strong-password

# MinIO / 文档存储
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
DOCUMENT_BUCKET=documents

# 微信小程序订阅消息
# AppSecret 建议放 dam-miniprogram/wechat-keys/wechat.env。
WECHAT_MINIPROGRAM_APP_ID=wx0915df56d799f471
WECHAT_MINIPROGRAM_APP_SECRET=
WECHAT_RISK_TEMPLATE_ID=5NGdwcxDcjqwTuuCCp-LTbiSEl4Cp8N08wN-0R-WbcA
WECHAT_RISK_TEMPLATE_FIELDS=thing1,thing2,thing3,time4
WECHAT_RISK_SUBSCRIPTION_TYPE=once
WECHAT_NOTIFY_ENABLED=true
